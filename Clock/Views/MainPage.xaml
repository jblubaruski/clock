<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Clock.Views.MainPage"
    xmlns:drawable="clr-namespace:Clock.ViewModels.Drawables"
    xmlns:viewmodel="clr-namespace:Clock.ViewModels"
    Shell.NavBarIsVisible="false"
    x:DataType="viewmodel:MainPageViewModel"
    Padding="0">

    <ContentPage.Resources>
        <toolkit:MathExpressionConverter x:Key="MathExpressionConverter"/>
        
        <drawable:ClockFace x:Key="drawable"/>
        
        <x:Double x:Key="DefaultSecondHandRotation">0.0</x:Double>
        <x:Double x:Key="DefaultMinuteHandRotation">0.0</x:Double>
        <x:Double x:Key="DefaultHourHandRotation">0.0</x:Double>

        <Style x:Key="InvalidEntryTextStyle" TargetType="Entry" BasedOn="{StaticResource EntryStyle}">
            <Setter Property="TextColor" Value="Red"/>
        </Style>
        <Style x:Key="ValidEntryTextStyle" TargetType="Entry" BasedOn="{StaticResource EntryStyle}">
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="VerticalOptions" Value="Fill"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
            <Setter Property="MinimumHeightRequest" Value="0"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <!-- enabled state -->
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>

                            </VisualState.Setters>
                        </VisualState>
                        <!-- disabled state -->
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- pointer over state -->
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>

                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinimumHeightRequest" Value="30"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <!-- enabled state -->
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                
                            </VisualState.Setters>
                        </VisualState>
                        <!-- disabled state -->
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- pointer over state -->
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>

                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,Auto,*"
        RowSpacing="0"
        SafeAreaEdges="None">
        <!-- use system time / custom time controls -->
        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="0"
            Grid.Row="0">
            <Button
                Text="Use System Time"
                Style="{StaticResource ButtonStyle}"
                Command="{Binding UseSystemTimeCommand}"
                IsEnabled="{Binding IsUseSystemTimeButtonEnabled}"
                Grid.Column="0"/>
            <Entry
                x:Name="enterCustomTimeEntryBox"
                Placeholder="Enter a custom time (hh:mm:ss)"
                Text="{Binding CustomTimeEntryText}"
                Style="{StaticResource EntryStyle}"
                ReturnCommand="{Binding EnterCustomTimeCommand}"
                IsEnabled="{Binding IsEnterCustomTimeEntryEnabled}"
                Grid.Column="1"/>
        </Grid>
        <!-- start and stop clock buttons -->
        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="0"
            Grid.Row="1">
            <Button
                Text="Start Clock"
                Style="{StaticResource ButtonStyle}"
                Command="{Binding StartClockButtonClickedCommand}"
                IsEnabled="{Binding IsStartClockButtonEnabled}"
                Grid.Column="0"/>
            <Button
                Text="Stop Clock"
                Style="{StaticResource ButtonStyle}"
                Command="{Binding StopClockButtonClickedCommand}"
                IsEnabled="{Binding IsStopClockButtonEnabled}"
                Grid.Column="1"/>
        </Grid>
        <!-- clock display -->
        <GraphicsView
            x:Name="graphicsView"
            Drawable="{StaticResource drawable}"
            Grid.Row="2"/>
    </Grid>

</ContentPage>
